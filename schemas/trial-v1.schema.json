{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SP7 PowerLab trial state",
  "type": "object",
  "required": ["trial_id", "state"],
  "properties": {
    "trial_id": {"type": "string"},
    "proposal_id": {"type": ["string", "null"]},
    "context_scene": {"type": ["string", "null"]},
    "parameter": {"type": ["string", "null"]},
    "state": {
      "enum": [
        "PROPOSED", "VALIDATED", "WAITING_FOR_CONTEXT", "SNAPSHOTTED",
        "APPLIED", "READBACK_OK", "SETTLING", "MEASURING", "EVALUATING",
        "INSUFFICIENT_DATA", "REJECTED", "FAILED", "ROLLED_BACK",
        "CANDIDATE_WINNER", "REVALIDATION", "PROMOTED"
      ]
    }
  }
}
