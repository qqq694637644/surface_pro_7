{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qqq694637644/surface_pro_7/schemas/proposal-v1.schema.json",
  "title": "SP7 PowerLab tuning proposal",
  "type": "object",
  "required": [
    "schema_version",
    "based_on_experiment",
    "source",
    "title",
    "rationale",
    "change",
    "expected_effect",
    "risk",
    "rollback",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string" },
    "based_on_experiment": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "change": {
      "type": "object",
      "required": ["parameter", "from", "to"],
      "properties": {
        "parameter": { "type": "string", "minLength": 1 },
        "from": {},
        "to": {}
      },
      "additionalProperties": false
    },
    "expected_effect": {
      "type": "object",
      "required": ["average_power_delta_w", "usability", "confidence"],
      "properties": {
        "average_power_delta_w": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": ["number", "null"] },
            "max": { "type": ["number", "null"] }
          },
          "additionalProperties": false
        },
        "usability": { "type": "string" },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    },
    "risk": {
      "type": "object",
      "required": ["level", "notes"],
      "properties": {
        "level": { "enum": ["low", "medium", "high"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rollback": {
      "type": "object",
      "required": ["instruction"],
      "properties": {
        "instruction": { "type": "string", "minLength": 1 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["workload", "duration_seconds", "acceptance"],
      "properties": {
        "workload": { "type": "string", "minLength": 1 },
        "duration_seconds": { "type": "integer", "minimum": 60 },
        "acceptance": {
          "type": "object",
          "required": ["max_average_power_delta_w", "max_temperature_increase_c"],
          "properties": {
            "max_average_power_delta_w": { "type": ["number", "null"] },
            "max_temperature_increase_c": { "type": ["number", "null"] }
          }
        }
      }
    }
  }
}
