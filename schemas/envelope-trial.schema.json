{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SP7 PowerLab Envelope Trial",
  "type": "object",
  "required": ["kind", "baseline_envelope"],
  "properties": {
    "kind": {"const": "envelope"},
    "baseline_envelope": {"type": "string"},
    "candidate_envelope": {"type": "string"},
    "changes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "epp": {
          "enum": ["performance", "balance_performance", "balance_power", "power"]
        },
        "max_perf_pct": {"type": "integer", "minimum": 10, "maximum": 100},
        "turbo": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"required": ["changes"], "not": {"required": ["candidate_envelope"]}},
    {"required": ["candidate_envelope"], "not": {"required": ["changes"]}}
  ],
  "additionalProperties": false
}
