{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SP7 PowerLab tuning proposal v2",
  "type": "object",
  "required": [
    "schema_version", "source", "title", "rationale", "context",
    "change", "objective", "expected_effect", "risk", "rollback", "validation"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string"},
    "based_on_experiment": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "required": ["scene", "min_confidence"],
      "properties": {
        "scene": {"type": "string", "minLength": 1},
        "min_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "change": {
      "type": "object",
      "required": ["parameter", "from", "to"],
      "properties": {
        "parameter": {"type": "string", "minLength": 1},
        "from": {},
        "to": {}
      }
    },
    "objective": {"type": "object"},
    "expected_effect": {"type": "object"},
    "risk": {"type": "object"},
    "rollback": {"type": "object"},
    "validation": {
      "type": "object",
      "required": [
        "duration_seconds", "min_valid_minutes",
        "baseline_lookback_hours", "acceptance"
      ],
      "properties": {
        "duration_seconds": {"type": "integer", "minimum": 60},
        "min_valid_minutes": {"type": "number", "exclusiveMinimum": 0},
        "baseline_lookback_hours": {"type": "number", "exclusiveMinimum": 0},
        "acceptance": {"type": "object"}
      }
    }
  }
}
