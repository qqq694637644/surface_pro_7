{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SP7 PowerLab usage context",
  "type": "object",
  "required": ["context_id", "scene", "confidence", "features", "rule_version"],
  "properties": {
    "context_id": {"type": "string"},
    "scene": {
      "enum": [
        "idle", "reading", "web_interactive", "coding_interactive",
        "office_interactive", "remote_interactive", "background_compute",
        "compile", "media_playback", "video_call", "file_transfer",
        "mixed", "unknown"
      ]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "features": {"type": "object"},
    "rule_version": {"type": "string"}
  }
}
