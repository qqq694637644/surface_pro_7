[Unit]
Description=Surface Pro 7 PowerLab privileged parameter helper
After=local-fs.target

[Service]
Type=simple
User=root
WorkingDirectory=/
ExecStart=@POWERLAB_BIN@ root-helper --socket @SOCKET@ --allow-user @USER@
Restart=on-failure
RestartSec=3
RuntimeDirectory=sp7-powerlab
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
