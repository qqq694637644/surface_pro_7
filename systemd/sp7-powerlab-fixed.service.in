[Unit]
Description=Surface Pro 7 PowerLab persistent fixed-good envelope
After=default.target
StartLimitIntervalSec=60
StartLimitBurst=1

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
ExecStart=@POWERLAB_BIN@ envelope apply-fixed
RemainAfterExit=yes
Environment=PYTHONUNBUFFERED=1
Environment=SP7_POWERLAB_ROOT=@ROOT@

[Install]
WantedBy=default.target
